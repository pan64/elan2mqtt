{
  "name": "eLAN MQTT",
  "version": "1.15",
  "slug": "elan2mqtt",
  "description": "MQTT gateway for eLAN",
  "arch": ["armhf", "armv7", "aarch64", "amd64", "i386"],
  "startup": "before",
  "boot": "auto",
  "options": {
    "eLanURL": "http://192.168.3.136",
    "MQTTserver": "192.168.3.176",
    "mqtt_user": "elan",
    "mqtt_pass": "elan",
    "username": "user",
    "password": "user",
    "log_level": "info",
    "disable_autodiscovery": false,
    "mqtt_id": "elan",
    "publish_interval": 300,
    "discover_interval": 600,
    "socket_interval": 0,
    "device_refresh_interval": 3600
  },
  "schema": {
    "eLanURL": "str",
    "MQTTserver": "str",
    "username": "str",
    "password": "str",
    "log_level": "match(^(trace|debug|info|notice|warning|error|fatal)$)",
    "disable_autodiscovery": "bool?",
    "mqtt_id": "str?",
    "device_refresh_interval": "int?"
  },
  "logging": {
    "formatter": "%(asctime)s %(filename)s:%(lineno)d %(coproc)s/%(levelname)s - %(message)s",
    "log_level": "error"
  },
  "internal": {
    "constants": {
      "HTTP_TIMEOUT": 10,
      "WEBSOCKET_PING_TIMEOUT": 1000,
      "WEBSOCKET_RECV_TIMEOUT": 100,
      "MQTT_RECONNECT_DELAY": 5,
      "NETWORK_RECONNECT_DELAY": 10,
      "ERROR_RETRY_DELAY": 1,
      "WEBSOCKET_ERROR_DELAY": 5,
      "LOCK_WAIT_TIMEOUT": 10,
      "MAIN_LOOP_INTERVAL": 10
    }
  }
}
